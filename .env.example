# ============================================================
# College Complaint Intelligence System — Environment Variables
# ============================================================

# Application Environment (development | staging | production)
# Note: When ENV=production, PostgreSQL is strictly enforced and SQLite is prohibited.
ENV=development
DEBUG=true

# Security Secret Key (Generate a random 32+ character string in production)
# Example: openssl rand -hex 32
SECRET_KEY=change-this-in-production-to-a-secure-random-32-byte-hex

# Database Configuration
# ----------------------
# PostgreSQL Connection String (Port 5432 is default for PostgreSQL Windows Service):
# DATABASE_URL=postgresql://complaint_user:your_secure_password_here@localhost:5432/complaint_db
#
# SQLite Local Fallback (Automatically used if DATABASE_URL is unset or commented out):
# DATABASE_URL=sqlite:///./backend/complaints.db

# Enable Automated Demonstration Seeding (student, staff, admin demo users + sample complaints)
ENABLE_DEMO_SEED=true

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://localhost:8000,http://127.0.0.1:8000

# Server Host and Port
PORT=8000
HOST=0.0.0.0

