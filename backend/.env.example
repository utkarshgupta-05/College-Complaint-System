# ============================================================
# College Complaint Intelligence System — Environment Variables
# ============================================================

# Application Environment (development | staging | production)
ENV=development
DEBUG=true

# Security Key (Generate a random 32+ character string in production)
# Example: openssl rand -hex 32
SECRET_KEY=change-this-in-production-to-a-secure-random-32-byte-hex

# Database Configuration
# PostgreSQL Production Example:
# DATABASE_URL=postgresql://complaint_user:complaint_password@localhost:5432/complaint_db
# SQLite Local Development / Testing Fallback:
DATABASE_URL=sqlite:///./complaints.db

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Server Host and Port
PORT=8000
HOST=0.0.0.0

